/* syscon@fd5d0000 */
&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	//vbus-supply = <&vcc5v0_otg>;
	//phy-supply = <&vcc5v0_host>;
	status = "okay";
};

/* syscon@fd5d4000 */
&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

/* syscon@fd5d8000 */
&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

/* syscon@fd5dc000 */
&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

/* phy@fed80000 */
&usbdp_phy0 {
	//orientation-switch;
	//sbu1-dc-gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
	//sbu2-dc-gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
	rockchip,dp-lane-mux = <0 1>;
	status = "okay";
};

/* phy@fed90000 */
&usbdp_phy1 {
	status = "okay";
	maximum-speed = "high-speed";
	rockchip,dp-lane-mux = <3 2 1 0>;
};

/* usb@fc800000 
 * phy is u2phy2_host */
&usb_host0_ehci {
	status = "okay";
};

/* usb@fc840000 
 * phy is u2phy2_host */
&usb_host0_ohci {
	status = "okay";
};

/*   usb@fc000000
 * typec0:
 *   host: usb_host0_xhci
 *   usb2.0 phy: usb2phy0_grf/u2phy0/u2phy0_otg
 *   usb3.0 phy: usbdp_phy0
 */
&usb_host0_xhci {
	extcon = <&u2phy0>;
	dr_mode = "otg";
	status = "okay";
};

/* usb@fc880000 
 * phy is u2phy3_host */
&usb_host1_ehci {
	status = "okay";
};

/* usb@fc8c0000 
 * phy is u2phy3_host */
&usb_host1_ohci {
	status = "okay";
};

/* usb@fc400000
 * typec1:
 * host: usb_host1_xhci
 * usb2.0 phy: usb2phy1_grf/u2phy1/u2phy1_otg
 * usb3.0 phy: usbdp_phy1
 * connect to TYPEC HUB
 */ 
&usb_host1_xhci {
	dr_mode = "host";
	maximum-speed = "high-speed";
	status = "okay";
};

/* usb@fcd00000
 * phy is combphy2_psu
 * but combphy2_psu is used by pcie2x1l1
 */
&usb_host2_xhci {
	status = "okay";
};

