&route_hdmi0 {
	status = "okay";
	connect = <&vp0_out_hdmi0>;
	force-output;
	logo,uboot = "logo.bmp";
	logo,kernel = "logo_kernel.bmp";
	logo,mode = "center";
	charge_logo,mode = "center";
};

&route_hdmi1 {
	status = "okay";
	connect = <&vp1_out_hdmi1>;
	force-output;
	logo,uboot = "logo.bmp";
